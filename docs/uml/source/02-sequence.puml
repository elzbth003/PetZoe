@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 11
skinparam roundCorner 4
skinparam ArrowColor black
skinparam SequenceLifeLineBorderColor black
skinparam SequenceGroupBorderColor black

title Sequence Diagram - Book Veterinary Appointment

actor "Pet Owner" as Owner
participant "Web Application" as WebApp
participant "Backend Server" as Backend
participant "Veterinarian\nPortal" as VetPortal
participant "Database\n(MySQL)" as DB

Owner -> WebApp : 1. Login
activate WebApp
WebApp -> Backend : 1.1 Authenticate
activate Backend
Backend -> DB : 1.2 Verify Credentials
activate DB
DB --> Backend : 1.3 User Verified
deactivate DB
Backend --> WebApp : 1.4 Login Success
deactivate Backend
WebApp --> Owner : 1.5 Dashboard
deactivate WebApp

Owner -> WebApp : 2. Search Veterinarian
activate WebApp
WebApp -> Backend : 2.1 Request Veterinarian List
activate Backend
Backend -> DB : 2.2 Fetch Veterinarians
activate DB
DB --> Backend : 2.3 Available Veterinarians
deactivate DB
Backend --> WebApp : 2.4 Display Veterinarians
deactivate Backend
WebApp --> Owner : Display Veterinarians
deactivate WebApp

Owner -> WebApp : 3. Select Veterinarian\n& Time Slot
activate WebApp
WebApp -> Backend : 3.1 Check Availability
activate Backend
Backend -> DB : 3.2 Verify Slot
activate DB
DB --> Backend : 3.3 Slot Available
deactivate DB
Backend --> WebApp : 3.4 Available Slot
deactivate Backend
WebApp --> Owner : Show Available Slot
deactivate WebApp

Owner -> WebApp : 4. Confirm Appointment
activate WebApp
WebApp -> Backend : 4.1 Create Appointment
activate Backend
Backend -> DB : 4.2 Save Appointment\n(Pending)
activate DB
DB --> Backend : 4.3 Appointment Saved
deactivate DB

Backend -> VetPortal : 5. Send Appointment Request
activate VetPortal
VetPortal -> VetPortal : 5.1 Accept Appointment
VetPortal -> Backend : 5.2 Update Status (Accepted)
Backend --> VetPortal : 5.3 Update Success
deactivate VetPortal

Backend --> WebApp : 5.4 Appointment Confirmed
deactivate Backend
WebApp --> Owner : 5.5 Confirmation Message
deactivate WebApp

VetPortal -> Backend : 6. Upload Prescription
activate VetPortal
activate Backend
Backend -> DB : 6.1 Save Prescription
activate DB
DB --> Backend : 6.2 Prescription Saved
deactivate DB

Backend -> Backend : 6.3 Update Medical Record
Backend -> DB : 6.4 Save Medical Record
activate DB
DB --> Backend : 6.5 Record Updated
deactivate DB

Backend --> WebApp : 6.6 Consultation Completed
deactivate Backend
deactivate VetPortal
activate WebApp
WebApp --> Owner : 6.7 View Prescription
deactivate WebApp

Backend -> WebApp : 7. Send Notification
activate Backend
activate WebApp
WebApp --> Owner : 7.1 View Appointment History
deactivate WebApp
deactivate Backend

@enduml
