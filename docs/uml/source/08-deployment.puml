@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 10
skinparam roundCorner 4
skinparam ArrowColor black
skinparam NodeBorderColor black

title 4.2.8 Deployment Diagram - PetZoe Distributed System Architecture

node "<<device>>\nClient Workstation / Mobile Device" as ClientDevice {
    node "<<execution environment>>\nModern Web Browser\n(Chrome / Firefox / Edge / Safari)" as BrowserEnv {
        artifact "<<artifact>>\nReact 19 SPA Bundle\n(HTML5, CSS3, Tailwind, JS)" as ReactApp
    }
}

node "<<device>>\nReverse Proxy & Gateway Server" as ProxyServer {
    node "<<execution environment>>\nNginx 1.25" as NginxEnv {
        artifact "<<artifact>>\nNginx Configuration\n(SSL Termination & Load Balancing)" as NginxConf
    }
}

node "<<device>>\nBackend Application Server" as AppHost {
    node "<<execution environment>>\nJVM (Java 21 LTS)\nEmbedded Apache Tomcat (Port 8080)" as TomcatEnv {
        artifact "<<artifact>>\npetzoe-core-api.jar\n(Spring Boot 3, Spring Security, JWT)" as SpringArtifact
    }
    
    node "<<execution environment>>\nPython 3.11 Runtime\nUvicorn ASGI Server (Port 8001)" as PythonEnv {
        artifact "<<artifact>>\nvetscan-service.py\n(FastAPI & PyTorch/TorchVision Model)" as FastApiArtifact
    }
}

node "<<device>>\nDatabase Server" as DBHost {
    node "<<execution environment>>\nPostgreSQL 16 Engine (Port 5432)" as PostgreSQLEnv {
        database "petzoe_relational_db\n(Users, Pets, Vets, Appointments,\nRecords, Orders, Rehoming)" as RelationalDB
    }
}

node "<<device>>\nExternal Cloud & Third-Party Services" as CloudHost {
    node "<<execution environment>>\nGoogle Cloud Platform" as GCPEnv {
        artifact "<<artifact>>\nGemini 1.5 Pro Flash API\n(RAG / Chatbot Pipeline)" as GeminiAPI
    }
    node "<<execution environment>>\nPayment Gateway" as RazorpayEnv {
        artifact "<<artifact>>\nRazorpay Payment API\n(Webhook & Order Verification)" as RazorpayAPI
    }
    node "<<execution environment>>\nCloud Storage & Messaging" as StorageEnv {
        artifact "<<artifact>>\nFirebase / Cloudinary\n(Medical Records & Pet Photos)" as MediaStorage
        artifact "<<artifact>>\nSMTP / Firebase Messaging\n(Email & Alerts)" as EmailNotif
    }
}

' Communication Paths
ClientDevice -- ProxyServer : HTTPS (Port 443)\nWSS (WebSocket)
ProxyServer -- TomcatEnv : Reverse Proxy HTTP (Port 8080)
ProxyServer -- ReactApp : Static Asset Serving

TomcatEnv -- DBHost : TCP/IP JDBC (Port 5432)
TomcatEnv -- PythonEnv : REST API HTTP (Port 8001)

TomcatEnv -- GCPEnv : HTTPS / REST API
TomcatEnv -- RazorpayEnv : HTTPS / REST (TLS 1.3)
TomcatEnv -- StorageEnv : HTTPS / REST (TLS 1.3)

@enduml
